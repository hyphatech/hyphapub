---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<div class="mx-auto max-w-page px-4 py-16 sm:px-6 md:my-auto md:py-20">
  <div class="grid gap-y-5 md:grid-cols-margin">
    <div class="md:col-start-2">
      <h1 class="t-display max-w-[40rem]">{title}</h1>
      {lede && <p class="t-lede mt-8 max-w-[34rem] text-balance">{lede}</p>}
      <p class="mt-10 flex flex-wrap gap-3">
        <slot />
      </p>
    </div>
  </div>
</div>
