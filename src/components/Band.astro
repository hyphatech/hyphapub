---
interface Props {
  hero?: boolean;
}
const { hero = false } = Astro.props;
---

<section class="theme-ember relative isolate overflow-hidden -mt-(--masthead) pt-(--masthead)">
  <div class="k-grain" aria-hidden="true"></div>
  <div class="k-halftone max-md:top-(--masthead)" aria-hidden="true"></div>
  <div class:list={["relative mx-auto max-w-page px-4 sm:px-6", hero ? "pt-16 pb-12 md:pt-32 md:pb-16" : "py-12 md:py-16"]}>
    <slot />
  </div>
</section>
