---
import Icon from "./Icon.astro";
import Calendar from "@lucide/astro/icons/calendar";
import Clock from "@lucide/astro/icons/clock";
import { authors } from "../lib/authors";
import { fullDate, minutes, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { name, avatar } = authors[post.data.author];
---

<div class="flex items-center gap-4 md:gap-5">
  <img src={avatar} alt="" width="64" height="64" class="avatar size-12 shrink-0 md:size-16" />
  <dl class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-1 md:gap-y-2">
    <dt class="sr-only">Author</dt>
    <dd class="basis-full font-serif text-xl text-ink md:text-2xl">
      <a
        href={`/author/${post.data.author}/`}
        class="relative underline after:absolute after:inset-x-0 after:-inset-y-2 after:content-[''] decoration-graphite/50 decoration-1 underline-offset-[0.18em] transition-colors hover:decoration-ink"
      >
        {name}
      </a>
    </dd>
    <dt class="sr-only">Published</dt>
    <dd class="text-sm flex items-center gap-2 text-graphite">
      <Icon icon={Calendar} /><time datetime={post.data.date.toISOString()}>{fullDate(post.data.date)}</time>
    </dd>
    <dt class="sr-only">Reading time</dt>
    <dd class="text-sm flex items-center gap-2 text-graphite"><Icon icon={Clock} /><span data-minutes>{minutes(post)} min read</span></dd>
  </dl>
</div>
