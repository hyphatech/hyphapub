---
import Wordmark from "../components/Wordmark.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import Factory from "@lucide/astro/icons/factory";
import Archive from "@lucide/astro/icons/archive";
import Rss from "@lucide/astro/icons/rss";
import CodeXml from "@lucide/astro/icons/code-xml";
import "../styles/site.css";
/* Preloaded: fetched late, either face would reflow the words as it arrives. */
import slab from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url";
import sans from "@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url";
/* Built under a name that hashes its bytes: a site that cached the card
   by its address fetches it again once the card changes. */
import card from "../assets/og.jpg?url";

interface Props {
  title?: string;
  description: string;
  article?: { image?: string; published: Date; modified?: Date; author: string };
  lost?: boolean;
  banded?: boolean;
}

const { title, description, article, lost = false, banded = false } = Astro.props;
const site = "Hypha Pub";
const fullTitle = title ? `${title} · ${site}` : site;
/* Built as files: the canonical address has no ".html" and no trailing slash. */
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(.)\/$/, "$1").replace(/^\/index$/, "/");
const canonical = new URL(path, Astro.site);
const within = (href: string) => path === href || path.startsWith(`${href}/`);
const image = new URL(article?.image ?? card, Astro.site);

const nav = [
  { label: "Archive", href: "/archive", icon: Archive },
  { label: "Foundation", href: "https://hyphatech.io/", icon: Factory },
];
/* Another site opens in a tab of its own: the reader keeps their place here. */
const away = (href: string) => (/^https?:/.test(href) ? { target: "_blank", rel: "noopener" } : {});
const footer = [
  nav[0],
  { label: "RSS", href: "/rss.xml", icon: Rss },
  nav[1],
  { label: "GitHub", href: "https://github.com/hyphatech", icon: CodeXml },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <link rel="preload" href={slab} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {lost ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#15120E" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title ?? site} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {
      article ? (
        <>
          <meta property="og:type" content="article" />
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          <meta property="article:author" content={article.author} />
        </>
      ) : (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-dvh flex-col bg-ivory text-ink">
    <a href="#main" class="btn-primary absolute top-3 left-4 z-10 -translate-y-24 focus-visible:translate-y-0 sm:left-6">Skip to content</a>
    <div>
    <header class:list={["relative z-10", !banded && "md:border-b md:border-rule"]}>
      <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-4 sm:px-6">
        <Wordmark />
        <nav
          class:list={[
            "ml-auto hidden items-center gap-6 md:flex",
            banded && "[--color-graphite:color-mix(in_oklab,var(--graphite-on-night)_70%,var(--paper))]",
          ]}
          aria-label="Site"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                {...away(item.href)}
                aria-current={path === item.href ? "page" : within(item.href) ? "true" : undefined}
                class:list={[
                  "t-control tap inline-flex items-center gap-2 transition-colors hover:text-ink",
                  within(item.href) ? "text-ink" : "text-graphite",
                ]}
              >
                <Icon icon={item.icon} />
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <nav class:list={["h-14 border-y border-rule md:hidden", banded && "[--color-graphite:color-mix(in_oklab,var(--graphite-on-night)_70%,var(--paper))]"]} aria-label="Site">
        <ul class="mx-auto flex h-full max-w-page items-center gap-0.5 overflow-x-auto px-1.5 [scrollbar-width:none] min-[22.5rem]:gap-1 min-[22.5rem]:px-2 sm:px-4 [&::-webkit-scrollbar]:hidden">
          {
            nav.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  {...away(item.href)}
                  aria-current={path === item.href ? "page" : within(item.href) ? "true" : undefined}
                  class="nav-item gap-1.5 px-2 py-2.5 min-[22.5rem]:gap-2 min-[22.5rem]:px-3"
                >
                  <Icon icon={item.icon} />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    </div>

    <main id="main" tabindex="-1" class="theme-light flex grow flex-col pb-16 outline-none md:pb-20 *:w-full">
      <slot />
    </main>

    <div>
    <footer class="k-horizon border-t border-rule bg-bottom bg-no-repeat [background-size:100%_260%]">
      <div class="k-grain" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-page gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto] md:gap-16">
        <div class="max-w-lg">
          <div class="flex items-center gap-2">
            <Mark class="h-6" />
            <span class="text-base leading-none font-medium">hypha</span>
          </div>
          {/* Required by the trading disclosure rules. */}
          <p class="t-caption mt-4 text-graphite">
            <span class="block">
              <span class="inline-block">© {new Date().getFullYear()} Hypha Technologies Ltd.</span> <span class="inline-block">Registered in England and Wales, no.&nbsp;16665133.</span>
            </span>
            <span class="block">
              <span class="inline-block">Registered office:</span> <span class="inline-block">86–90&nbsp;Paul Street, London EC2A&nbsp;4NE.</span>
            </span>
            <span class="mt-3 block">Made in London.</span>
          </p>
        </div>
        <ul class="t-control grid grid-cols-2 content-start gap-x-10 gap-y-3 text-graphite pointer-coarse:gap-y-0">
          {
            footer.map((item) => (
              <li>
                <a class="tap inline-flex items-center gap-2 transition-colors hover:text-ink" href={item.href} {...away(item.href)}>
                  <Icon icon={item.icon} />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
    </div>
    <script>
      const rest = new IntersectionObserver((entries) => {
        for (const e of entries) e.target.toggleAttribute("data-off", !e.isIntersecting);
      });
      for (const el of document.querySelectorAll(".theme-ember")) rest.observe(el);
    </script>
  </body>
</html>
