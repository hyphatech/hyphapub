---
import Base from "../../layouts/Base.astro";
import Stream from "../../components/Stream.astro";
import Band from "../../components/Band.astro";
import { authors, author, type AuthorKey } from "../../lib/authors";
import { posts, type Post } from "../../lib/posts";
import { authorSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const all = await posts();
  return (Object.keys(authors) as AuthorKey[])
    .map((key) => ({ key, signed: all.filter((post) => post.data.author === key) }))
    .filter(({ signed }) => signed.length > 0)
    .map(({ key, signed }) => ({ params: { author: key }, props: { key, signed } }));
}

interface Props {
  key: AuthorKey;
  signed: Post[];
}

const { key, signed } = Astro.props;
const { name, avatar, about } = author(key);
---

<Base banded profile schema={authorSchema(key)} title={name} description={about ? `${name}: ${about}` : `Every post by ${name} on hypha.pub, newest first.`}>
  <Band>
    <header class="grid md:grid-cols-margin">
      <div class="flex min-w-0 items-center gap-x-[calc(1rem+4px)] md:col-start-2 md:gap-x-[calc(1.5rem+4px)]">
        <img src={avatar} alt="" width="96" height="96" class="avatar size-16 shrink-0 md:size-20 lg:size-24" />
        <div class="min-w-0">
          <h1 class="t-h1">{name}</h1>
          {about && <p class="t-lede mt-1">{about}</p>}
        </div>
      </div>
    </header>
  </Band>
  <div class="mx-auto max-w-page px-4 pt-12 sm:px-6 md:pt-16">
    <Stream posts={signed} />
  </div>
</Base>
