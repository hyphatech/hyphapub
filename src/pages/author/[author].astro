---
import Base from "../../layouts/Base.astro";
import Stream from "../../components/Stream.astro";
import { authors, author, type AuthorKey } from "../../lib/authors";
import { posts, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const all = await posts();
  return (Object.keys(authors) as AuthorKey[])
    .map((key) => ({ key, signed: all.filter((post) => post.data.author === key) }))
    .filter(({ signed }) => signed.length > 0)
    .map(({ key, signed }) => ({ params: { author: key }, props: { key, signed } }));
}

interface Props {
  key: AuthorKey;
  signed: Post[];
}

const { key, signed } = Astro.props;
const { name, avatar, about } = author(key);
---

<Base title={name} description={about ? `${name}: ${about}` : `Every post by ${name} on hypha.pub, newest first.`}>
  <div class="mx-auto max-w-page px-4 sm:px-6">
    <header class="grid pt-14 pb-12 md:grid-cols-margin md:pt-24 md:pb-16">
      <div class="flex items-center gap-5 md:col-start-2 md:gap-6">
        <img src={avatar} alt="" width="80" height="80" class="size-16 shrink-0 rounded-full bg-panel object-cover md:size-20" />
        <div class="min-w-0">
          <h1 class="t-h1">{name}</h1>
          {about && <p class="t-lede mt-2 max-w-[var(--measure)] text-graphite">{about}</p>}
        </div>
      </div>
    </header>
    <Stream posts={signed} />
  </div>
</Base>
