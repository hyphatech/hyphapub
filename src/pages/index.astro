---
import Base from "../layouts/Base.astro";
import Empty from "../components/Empty.astro";
import Band from "../components/Band.astro";
import Icon from "../components/Icon.astro";
import Byline from "../components/Byline.astro";
import Rows from "../components/Rows.astro";
import Archive from "@lucide/astro/icons/archive";
import BookOpen from "@lucide/astro/icons/book-open";
import Rss from "@lucide/astro/icons/rss";
import { posts, ledeOf, opening } from "../lib/posts";

const all = (await posts()).filter((post) => post.data.front);
const [lead, ...rest] = all;

const lede = lead && ledeOf(lead);
---

<Base banded={!!lead} description="An engineering blog on AI, functional programming, system design and the history of IT.">
  {
    lead ? (
      <div>
        <h1 class="sr-only">Hypha Pub</h1>
        <article aria-labelledby="lead">
          <Band hero>
            <div class="grid md:grid-cols-margin">
              <div class="min-w-0 md:col-start-2">
                <h2 id="lead" class="t-display max-w-[var(--measure)]">
                  <a href={`/${lead.id}`} class="transition-opacity hover:opacity-80">
                    {lead.data.title}
                  </a>
                </h2>
                {lede && <p class="t-lede mt-8 max-w-[var(--measure)]">{lede}</p>}
                <div class="mt-10"><Byline post={lead} /></div>
              </div>
            </div>
          </Band>
          <div class="mx-auto grid max-w-page px-4 py-12 sm:px-6 md:grid-cols-margin md:py-16">
          <div class="min-w-0 md:col-start-2">
            {lead.data.cover && (
              <img
                src={lead.data.cover}
                alt=""
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="aspect-video w-full max-w-[var(--measure)] rounded-panel bg-panel object-cover"
              />
            )}
            <div class:list={["prose max-w-[var(--measure)]", lead.data.cover && "mt-8"]}>
              <Fragment set:html={opening(lead).join("")} />
            </div>
            <a href={`/${lead.id}`} class="btn mt-8" aria-label={`Continue reading ${lead.data.title}`}>
              <Icon icon={BookOpen} />
              Continue reading
            </a>
          </div>
          </div>
        </article>
        {rest.length > 0 && (
          <section class="border-t border-rule" aria-label="Earlier posts">
            <div class="mx-auto max-w-page px-4 pt-12 sm:px-6 md:pt-16">
              <Rows posts={rest} />
            </div>
          </section>
        )}
      </div>
    ) : (
      <Empty title="Nothing on the front page yet." lede="Every post so far is in the archive. The feed tells you when the next one is out.">
        <a class="btn" href="/archive"><Icon icon={Archive} />Read the archive</a>
        <a class="btn" href="/rss.xml"><Icon icon={Rss} />Follow the feed</a>
      </Empty>
    )
  }
</Base>
