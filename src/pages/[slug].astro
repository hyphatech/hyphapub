---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Arrow from "../components/Arrow.astro";
import Byline from "../components/Byline.astro";
import Band from "../components/Band.astro";
import ReadAs from "../components/ReadAs.astro";
import Title from "../components/Title.astro";
import Clock from "@lucide/astro/icons/clock";
import Copy from "@lucide/astro/icons/copy";
import Check from "@lucide/astro/icons/check";
import X from "@lucide/astro/icons/x";
import { postSchema } from "../lib/schema";
import { posts, minutes, ledeOf, cardOf, variantsOf, type Post, type Variant } from "../lib/posts";

/* Read next stays within a post's series: a series never leads out into another. */
export async function getStaticPaths() {
  const all = await posts();
  const variants = await variantsOf(all);
  return all.map((post) => {
    const run = all.filter((p) => p.data.series === post.data.series);
    const i = run.indexOf(post);
    return {
      params: { slug: post.id },
      props: { post, later: run[i - 1], earlier: run[i + 1], tldr: variants.get(post.id)?.tldr, slop: variants.get(post.id)?.slop },
    };
  });
}

interface Props {
  post: Post;
  later?: Post;
  earlier?: Post;
  tldr?: Variant;
  slop?: Variant;
}

const { post, later, earlier, tldr, slop } = Astro.props;
const { Content, headings } = await render(post);
const Tldr = tldr && (await render(tldr)).Content;
const Slop = slop && (await render(slop)).Content;
const modes = [
  { key: "original" as const, name: "As written", minutes: minutes(post) },
  ...(tldr ? [{ key: "tldr" as const, name: "TL;DR", minutes: minutes(tldr) }] : []),
  ...(slop ? [{ key: "slop" as const, name: "Slop", minutes: minutes(slop) }] : []),
];
/* The footnotes' heading is for screen readers, not a section. */
const sections = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
const contents = sections.length >= 2 ? sections : [];
const lede = ledeOf(post);
const plain = (s: string) => s.replace(/\*\*|__/g, "");
const next = later;
const back = earlier;
---

<Base
  banded
  title={post.data.title}
  description={post.data.description}
  article={{ image: post.data.cover, card: cardOf(post), published: post.data.date, modified: post.data.updated, author: `/author/${post.data.author}/` }}
  schema={postSchema(post)}
>
  <article>
    <Band hero>
      <header class="grid md:grid-cols-margin">
        <div class="min-w-0 md:col-start-2">
          <h1 class="t-display max-w-(--measure-title)"><Title post={post} /></h1>
          <div class="mt-8 md:mt-10"><Byline post={post} /></div>
          {modes.length > 1 && <ReadAs modes={modes} />}
        </div>
      </header>
    </Band>

    <div class="mx-auto max-w-page px-4 sm:px-6">
    <div class="grid pt-12 md:grid-cols-margin md:pt-16">
      <aside class="hidden lg:block">
        {
          /* The nav scrolls, so it clips: its padding, taken back by a
             margin, is room for a link's focus ring. */
          contents.length > 0 && (
            <nav
              class="sticky top-6 -mx-2 -mt-2 max-h-[calc(100dvh-4rem)] overflow-y-auto px-2 pt-2 pb-8"
              aria-label="Contents"
              data-contents
            >
              <ol class="space-y-2 border-l border-rule">
                {contents.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l border-transparent pl-3 pointer-coarse:py-3 text-sm  text-graphite transition-colors hover:text-ink aria-[current]:border-ink aria-[current]:text-ink"
                    >
                      {plain(h.text)}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
      <div class="prose min-w-0 md:col-start-2" data-mode-text>
        {/* The description opens the text it leads into, never the band above it. */}
        {lede && <p>{lede}</p>}
        <Content />
      </div>
      {
        /* In templates, so search, the feed and a reader without scripts see only the text as written. */
        Tldr && (
          <template id="mode-tldr">
            <Tldr />
          </template>
        )
      }
      {
        Slop && (
          <template id="mode-slop">
            <Slop />
          </template>
        )
      }
    </div>

    <footer class="grid md:grid-cols-margin">
      <div class="min-w-0 max-w-[var(--measure)] md:col-start-2">
        {
          (next || back) && (
            <nav class="mt-12" aria-label="More posts">
              <div class="overflow-hidden rounded-panel border border-rule">
                {next && (
                <div
                  class:list={[
                    "group relative grid items-center gap-7 p-7 transition-colors hover:bg-panel",
                    next.data.cover && "sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]",
                  ]}
                >
                  {
                    next.data.cover && (
                      <span class="block overflow-hidden rounded-panel bg-panel">
                        <img
                          src={next.data.cover}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="aspect-video w-full object-cover transition-transform duration-700 ease-glide group-hover:scale-[1.025]"
                        />
                      </span>
                    )
                  }
                  <span class="flex min-w-0 flex-col">
                    <a href={`/${next.id}/`} class="t-h3 entry-link stretch focus-inset group-hover:decoration-graphite">
                      {next.data.title}
                    </a>
                    <span class=" text-graphite mt-2 line-clamp-2">{next.data.description}</span>
                    {/* No date: that is the archive's business, not a reader's choosing the next part. */}
                    <span class="text-sm mt-4 flex items-center gap-5 text-graphite">
                      <span class="flex items-center gap-2"><Icon icon={Clock} />{minutes(next)} min read</span>
                      <span class="t-control ml-auto flex items-center gap-2 whitespace-nowrap text-ink">
                        Read next
                        <Arrow way="on" />
                      </span>
                    </span>
                  </span>
                </div>
                )}
                {
                  back && (
                    <a
                      href={`/${back.id}/`}
                      class:list={["group t-control focus-inset flex min-h-12 items-center gap-3 px-7 py-4 text-graphite transition-colors hover:bg-panel", next && "border-t border-rule"]}
                    >
                      <span class="flex shrink-0 items-center gap-2">
                        <Arrow way="back" />
                        Previous
                      </span>
                      <span class="entry-link min-w-0 truncate text-ink group-hover:decoration-graphite">{back.data.title}</span>
                    </a>
                  )
                }
              </div>
            </nav>
          )
        }
      </div>
    </footer>
    </div>
  </article>

  <template id="copy-icons"><Icon icon={Copy} /><Icon icon={Check} /><Icon icon={X} /></template>
  <p class="sr-only" role="status" data-copy-status></p>

  <script>
    const [copy, done, failed] = document.querySelector<HTMLTemplateElement>("#copy-icons")!.content.children;
    const status = document.querySelector<HTMLElement>("[data-copy-status]")!;
    const LABEL = "Copy code";
    /* Emptied first, so the same message twice is heard twice. */
    const tell = (message: string) => {
      status.textContent = "";
      requestAnimationFrame(() => (status.textContent = message));
    };
    /* Armed again whenever another version of the text is put in. */
    const arm = (root: ParentNode) =>
      root.querySelectorAll<HTMLElement>(".code:not(:has(> .copy))").forEach((block) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy";
        button.setAttribute("aria-label", LABEL);
        button.append(copy.cloneNode(true));
        let reset: number | undefined;
        /* A failure stays longer: it asks something of the reader. */
        const show = (icon: Element, state: "copied" | "failed", label: string, message: string) => {
          button.replaceChildren(icon.cloneNode(true));
          button.setAttribute("aria-label", label);
          button.title = message;
          button.dataset.state = state;
          tell(message);
          clearTimeout(reset);
          reset = setTimeout(
            () => {
              button.replaceChildren(copy.cloneNode(true));
              button.setAttribute("aria-label", LABEL);
              button.removeAttribute("title");
              delete button.dataset.state;
            },
            state === "failed" ? 4000 : 1600,
          );
        };
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(block.querySelector("code")?.innerText ?? "");
            show(done, "copied", "Copied", "Code copied");
          } catch {
            show(failed, "failed", "Not copied", "Couldn't copy: select the code and copy it by hand");
          }
        });
        block.append(button);
      });
    if (navigator.clipboard) {
      arm(document.querySelector(".prose")!);
      addEventListener("read-as", () => arm(document.querySelector(".prose")!));
    }
  </script>

  <script>
    /* A drawing's box is found from the drawing, not by `:has()`, which an
       older browser would refuse, and the script with it. */
    const scrollers = [
      ...[...document.querySelectorAll<HTMLElement>(".prose pre")].map((box) => [box, "Code"] as const),
      ...[...document.querySelectorAll<HTMLElement>(".prose > .table-wrap")].map((box) => [box, "Table"] as const),
      ...[...document.querySelectorAll<HTMLImageElement>(".prose > p > img.drawing:only-child")].map(
        (img) => [img.parentElement!, "Figure"] as const,
      ),
    ];
    const names = new Map<Element, string>(scrollers);
    const fit = (box: HTMLElement) => {
      if (box.scrollWidth > box.clientWidth) {
        box.setAttribute("tabindex", "0");
        box.setAttribute("role", "region");
        box.setAttribute("aria-label", names.get(box)!);
      } else {
        box.removeAttribute("tabindex");
        box.removeAttribute("role");
        box.removeAttribute("aria-label");
      }
    };
    const watch = new ResizeObserver((entries) => entries.forEach(({ target }) => fit(target as HTMLElement)));
    scrollers.forEach(([box]) => watch.observe(box));
    /* Code is set in the mono, which can arrive after the first measure. */
    document.fonts.ready.then(() => scrollers.forEach(([box]) => fit(box)));
  </script>

  <script>
    const control = document.querySelector<HTMLElement>("[data-read-as]");
    if (control) {
      control.hidden = false;
      const text = document.querySelector<HTMLElement>("[data-mode-text]")!;
      const contents = document.querySelector<HTMLElement>("[data-contents]");
      const original = [...text.childNodes];
      const group = control.querySelector<HTMLElement>("[role=radiogroup]")!;
      const buttons = [...group.querySelectorAll<HTMLButtonElement>("button")];
      const slide = () => {
        const on = buttons.find((b) => b.getAttribute("aria-checked") === "true")!;
        group.style.setProperty("--thumb-x", `${on.offsetLeft}px`);
        group.style.setProperty("--thumb-w", `${on.offsetWidth}px`);
      };
      const set = (mode: string) => {
        const template = document.querySelector<HTMLTemplateElement>(`#mode-${mode}`);
        if (mode !== "original" && !template) return;
        text.replaceChildren(...(template ? [template.content.cloneNode(true)] : original));
        if (contents) contents.hidden = mode !== "original";
        dispatchEvent(new Event("read-as"));
        buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.mode === mode)));
        slide();
        const on = buttons.find((b) => b.dataset.mode === mode)!;
        document.querySelector("[data-minutes]:not(button)")!.textContent = `${on.dataset.minutes} min read`;
        const url = new URL(location.href);
        if (mode === "original") url.searchParams.delete("read");
        else url.searchParams.set("read", mode);
        history.replaceState(null, "", url);
        localStorage.setItem("read", mode);
      };
      buttons.forEach((b) => b.addEventListener("click", () => set(b.dataset.mode!)));
      const asked = new URLSearchParams(location.search).get("read") ?? localStorage.getItem("read");
      if (asked) set(asked);
      slide();
      /* Placed before it may move, so the first choice on arrival does not slide. */
      requestAnimationFrame(() => (group.dataset.ready = ""));
      document.fonts.ready.then(slide);
      new ResizeObserver(slide).observe(group);
    }
  </script>

  <script>
    const nav = document.querySelector<HTMLElement>("[data-contents]");
    if (nav) {
      const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
      const targets = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((el): el is HTMLElement => el !== null);
      const mark = () => {
        const line = window.innerHeight / 3;
        let current = -1;
        targets.forEach((el, i) => {
          if (el.getBoundingClientRect().top <= line) current = i;
        });
        links.forEach((a, i) => (i === current ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current")));
      };
      let queued = false;
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      };
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
      mark();
    }
  </script>
</Base>
