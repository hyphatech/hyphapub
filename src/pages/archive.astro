---
import Base from "../layouts/Base.astro";
import Stream from "../components/Stream.astro";
import { posts } from "../lib/posts";

const all = await posts();
---

<Base title="Archive" description="Every post on hypha.pub, newest first.">
  <div class="mx-auto max-w-page px-4 sm:px-6">
    {/* The heading on the line; the margin below is the years'. */}
    <header class="grid pt-14 pb-12 md:grid-cols-margin md:pt-24 md:pb-16">
      <h1 class="t-h1 md:col-start-2">Archive</h1>
    </header>
    <Stream posts={all} />
  </div>
</Base>
