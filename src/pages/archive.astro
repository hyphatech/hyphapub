---
import Base from "../layouts/Base.astro";
import Stream from "../components/Stream.astro";
import Band from "../components/Band.astro";
import { posts } from "../lib/posts";

const all = await posts();
---

<Base banded title="Archive" description="Every post on hypha.pub, newest first.">
  <Band>
    <header class="grid md:grid-cols-margin">
      <h1 class="t-display md:col-start-2">Archive</h1>
    </header>
  </Band>
  <div class="mx-auto max-w-page px-4 pt-12 sm:px-6 md:pt-16">
    <Stream posts={all} />
  </div>
</Base>
